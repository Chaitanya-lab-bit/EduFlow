# EduFlow Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production-use-strong-secret-key

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduflow_db

# Complete Database URI (takes precedence if provided)
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password@localhost:5432/eduflow_db

# Test Database URI (SQLite in-memory or Postgres test db)
TEST_DATABASE_URL=sqlite:///:memory:
